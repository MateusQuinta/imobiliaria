# Supabase Configuration
# Crie um projeto em https://supabase.com e pegue estas credenciais
VITE_SUPABASE_URL=your_supabase_project_url
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# Google Analytics (opcional)
# Crie uma propriedade GA4 em https://analytics.google.com
VITE_GA_MEASUREMENT_ID=your_ga4_measurement_id

# Site Configuration
# Substitua pelo domínio real quando tiver
VITE_SITE_URL=https://yourdomain.com
